              "@babel/runtime-corejs3/core-js-stable/object/define-property",
              "@babel/runtime-corejs3/regenerator",
              "crypto-js",
              "@babel/runtime/helpers/get",
              "@babel/runtime/helpers/toConsumableArray",
              "@babel/runtime/helpers/inherits",
              "@babel/runtime/helpers/possibleConstructorReturn",
              "@babel/runtime/helpers/slicedToArray",
              "core-js/modules/es.array.map",
              "core-js/modules/es.reflect.get-prototype-of",
              "core-js/modules/es.reflect.apply",
              "core-js/modules/es.array.slice",
              "core-js/modules/es.map",
              "core-js/modules/es.symbol.iterator",
              "core-js/modules/es.symbol.description",
              "core-js/modules/web.dom-collections.iterator",
              "core-js/modules/es.array.iterator",
              "core-js/modules/es.reflect.delete-property",
              "core-js/modules/es.array.fill",
              "core-js/modules/es.number.constructor",
              "core-js/modules/es.array.reverse",
              "core-js/modules/es.array.index-of",
              "core-js/modules/es.string.trim",
              "core-js/modules/es.string.iterator",
              "core-js/modules/es.string.includes",
              "core-js/modules/es.array.some",
              "core-js/modules/es.array.includes",
              "core-js/modules/es.array.from",
              "core-js/modules/es.reflect.construct",
              "core-js/modules/es.regexp.to-string",
              "core-js/modules/es.function.name",
              "core-js/modules/es.string.split",
              "core-js/modules/es.promise",
              "core-js/modules/es.object.to-string",
              "core-js/modules/es.array.reduce",
              "core-js/modules/es.array.every",
              "core-js/modules/es.array.concat",
              "core-js/modules/web.dom-collections.for-each",
              "core-js/modules/es.object.keys",
              "core-js/modules/es.object.get-own-property-descriptors",
              "core-js/modules/es.object.get-own-property-descriptor",
              "core-js/modules/es.array.for-each",
              "core-js/modules/es.array.filter",
              "core-js/modules/es.array.join",
              "core-js/modules/es.symbol",
              "core-js/modules/es.string.starts-with",
              "core-js/modules/es.string.replace",
              "core-js/modules/es.string.match",
              "core-js/modules/es.regexp.exec"
            ],
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "aot": true,
            "assets": [
              "src/web.config",
              "src/favicon.ico",
              "src/assets",
              "src/fake-data",
              "src/amcharts",
              "src/assets/plugins/bootstrap-tagsinput-latest/js/bootstrap-tagsinput.min.js",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "node_modules/datatables.net-dt/css/jquery.dataTables.css",
              "node_modules/datatables.net-buttons-dt/css/buttons.dataTables.css",
              "node_modules/datatables.net-colreorder-dt/css/colReorder.dataTables.css",
              "node_modules/datatables.net-responsive-dt/css/responsive.dataTables.css",
              "node_modules/datatables.net-select-dt/css/select.dataTables.css",
              "node_modules/bootstrap/scss/bootstrap.scss",
              "src/assets/plugins/nestable-master/css/nestable.min.css",
              "src/assets/css/fullcalendar.bundle.css",
              "src/assets/plugins/modal-window-effects/css/md-modal.css",
              "node_modules/@mdi/font/scss/materialdesignicons.scss",
              "node_modules/flatpickr/dist/flatpickr.css",
              "node_modules/@ng-select/ng-select/themes/default.theme.css",
              "src/styles.scss"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.js",
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/raphael/raphael.js",
              "node_modules/datatables.net/js/jquery.dataTables.js",
              "node_modules/jszip/dist/jszip.js",
              "node_modules/datatables.net-buttons/js/dataTables.buttons.js",
              "node_modules/datatables.net-buttons/js/buttons.colVis.js",
              "node_modules/datatables.net-buttons/js/buttons.flash.js",
              "node_modules/datatables.net-buttons/js/buttons.html5.js",
              "node_modules/datatables.net-buttons/js/buttons.print.js",
              "node_modules/datatables.net-colreorder/js/dataTables.colReorder.js",
              "node_modules/datatables.net-responsive/js/dataTables.responsive.js",
              "node_modules/datatables.net-select/js/dataTables.select.js",
              "node_modules/datatables.net-rowgroup/js/dataTables.rowGroup.min.js",
              "src/assets/plugins/nestable-master/js/jquery.nestable.js",
              "src/assets/js/pages/ac-nestable.js",
              "node_modules/@ckeditor/ckeditor5-build-decoupled-document/build/translations/es.js",
              "node_modules/exceljs/dist/exceljs.min.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "20mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "25kb",
                  "maximumError": "25kb"
                }
              ],
              "serviceWorker": true,
              "ngswConfigPath": "ngsw-config.json"
            },
            "qa": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.qa.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "20mb",
                  "maximumError": "20mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "25kb",
                  "maximumError": "25kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "clinic:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "clinic:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "clinic:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "tsconfig.app.json",
              "tsconfig.spec.json",
              "e2e/tsconfig.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "clinic:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "clinic:serve:production"
            }
          }
        }
      }
    }
  },
  "defaultProject": "clinic",
  "cli": {
    "analytics": "58cb3b24-fc79-484d-af60-d581796fd9d8"
  }
}
