# Example environment overrides for docker-compose
# Copy this file to .env and set values as needed. Do NOT commit your real passwords.

# Tag to use for built images
IMAGE_TAG=3.2.1

# Azure Container Registry settings
ACR_LOGIN_SERVER=clialphav.azurecr.io
ACR_USERNAME=clialphav
# For login, prefer using:
#   printf '%s' "$ACR_PASSWORD" | docker login $ACR_LOGIN_SERVER -u $ACR_USERNAME --password-stdin
# Do not put the real password in .env unless absolutely necessary.
# ACR_PASSWORD=...
